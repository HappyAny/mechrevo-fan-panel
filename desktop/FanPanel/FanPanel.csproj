<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mechrevo-Fan</AssemblyName>
    <RootNamespace>FanPanel</RootNamespace>
    <Version>2.0.1</Version>
    <StartupObject>FanPanel.Program</StartupObject>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/app.png" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="FanPanel.License.txt" />
    <EmbeddedResource Include="../../docs/licenses/*.txt" />
  </ItemGroup>
</Project>
